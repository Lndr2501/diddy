<?xml version="1.0" encoding="utf-8"?>
<!-- Logins, the Matrix stores and keys never go into Android's cloud backup or a device transfer:
     a restored copy would be a second device with the same keys. Recovery goes through Matrix. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
