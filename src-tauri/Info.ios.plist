<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS additions, merged by `tauri ios build` on top of the generated Info.plist and Info.plist
  (which already carries the microphone and camera texts).
-->
<plist version="1.0">
<dict>
  <!-- The page is served by the in-app localhost server (tauri-plugin-localhost, port 44548). -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsLocalNetworking</key>
    <true/>
  </dict>
  <!-- Keep a running voice chat audible when the app goes to the background or the screen locks. -->
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
  </array>
  <key>NSPhotoLibraryAddUsageDescription</key>
  <string>Diddy saves images and videos from chats to your photo library.</string>
  <key>NSPhotoLibraryUsageDescription</key>
  <string>Diddy lets you send photos and videos from your library.</string>
  <!-- Diddy's default themes are dark; keep the status bar readable on them. -->
  <key>UIStatusBarStyle</key>
  <string>UIStatusBarStyleLightContent</string>
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <false/>
  <!-- Open shared files from the Files app in place instead of copying them. -->
  <key>LSSupportsOpeningDocumentsInPlace</key>
  <false/>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
</dict>
</plist>
