{
  "identifier": "app-commands",
  "description": "App commands: icon, diagnostics, isolated connections and MyInstants import",
  "local": true,
  "remote": {
    "urls": [
      "http://localhost:44548"
    ]
  },
  "windows": [
    "main",
    "connection-*"
  ],
  "permissions": [
    "allow-set-app-icon",
    "allow-myinstants-fetch-text",
    "allow-myinstants-fetch-audio",
    "allow-diag-log",
    "allow-log-path",
    "allow-open-log-folder",
    "allow-connection-profiles",
    "allow-open-connection-profile"
  ]
}
