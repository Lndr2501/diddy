{
  "name": "cinny",
  "version": "4.12.8",
  "description": "Yet another matrix client",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "prestart": "node scripts/patch-element-call.cjs",
    "start": "vite",
    "prebuild": "node scripts/patch-element-call.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run check:eslint && npm run check:prettier",
    "check:eslint": "eslint src/*",
    "check:prettier": "prettier --check .",
    "fix:prettier": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.cjs",
    "test": "node --test tests/*.test.cjs",
    "prepare": "husky install",
    "commit": "git-cz",
    "bump": "node scripts/update-version.js",
    "test:e2e": "playwright test",
    "test:ui:mac": "playwright test -c playwright.mac.config.cjs",
    "shots": "playwright test -c playwright.shots.config.cjs",
    "test:tiles": "playwright test -c playwright.preview.config.cjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint",
    "*": "prettier --ignore-unknown --write"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "keywords": [],
  "author": "Ajay Bura",
  "license": "AGPL-3.0-only",
  "dependencies": {
